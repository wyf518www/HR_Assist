# Replace with the exact external HTTPS origin; no path or trailing slash.
HR_PUBLIC_URL=https://hr.example.com
HR_ADMIN_USERNAME=admin
HR_PORT=8088
HR_UID=10001
HR_GID=10001
# Absolute NAS path is recommended. This directory must be writable by HR_UID.
HR_STORAGE_ROOT=/volume1/docker/hr-assist/storage
# Password is read from secrets/admin_password.txt, never committed to Git.
